-- ============================================================================
-- pgloader config per migrazione EasyWin: SQL Server (Gare) → Postgres (easywin_staging)
-- ============================================================================
-- Uso: pgloader --verbose pgloader-easywin.load
-- Prerequisiti: SQL Server "Gare" in Docker su localhost:1433
--                Postgres "easywin_staging" su localhost:5432
-- ============================================================================

LOAD DATABASE
     FROM      mssql://sa:EasyWin2026!@localhost:1433/Gare
     INTO      postgresql://easywin:CAMBIAMI_PASSWORD@localhost:5432/easywin_staging

-- ============================================================================
-- OPZIONI GENERALI
-- ============================================================================
WITH include drop,              -- drop tabelle esistenti su Postgres prima di creare
     create tables,             -- crea tabelle partendo dallo schema SQL Server
     create indexes,            -- ricrea indici (secondari; PK vengono sempre)
     reset sequences,           -- allinea sequenze al MAX(id) dopo il load
     foreign keys,              -- ricrea FK alla fine del load
     downcase identifiers,      -- TUTTI i nomi di tabelle/colonne in lowercase
                                -- (es. dbo.Bandi → public.bandi, IdBando → idbando)
     -- MEMORY TUNING: l'immagine dimitri/pgloader:latest ha SBCL heap fisso 1 GB.
     -- Ridotti batch + parallelismo per stare sotto il limite anche sulle
     -- tabelle grandi (legacy.bandi ~5 GB su disco). Trade-off: più lento ma
     -- non KABOOM.
     prefetch rows = 1000,      -- righe lette dal sorgente per batch (default 25000)
     batch rows = 1000,         -- righe scritte su Postgres per batch
     batch size = 20 MB,        -- limite hard sul singolo batch (NB: no apici!)
     workers = 1,               -- 1 worker per tabella (default = #core)
     concurrency = 1            -- 1 tabella alla volta (default 2)

-- ============================================================================
-- TUNING MEMORIA
-- ============================================================================
-- NB: max_wal_size NON va qui (è PGC_SIGHUP, server-level: richiede ALTER
-- SYSTEM o postgresql.conf). pgloader lo SET via SET LOCAL e Postgres
-- rifiuta con "55P02: parameter cannot be changed now". Per WAL pulito
-- in staging non serve comunque: il default 1 GB su Postgres 16 va bene.
SET work_mem TO '128MB',
    maintenance_work_mem TO '1GB'

-- ============================================================================
-- CAST: mappatura tipi SQL Server → Postgres
-- ============================================================================
-- Tipi nativi che pgloader gestisce automaticamente: int, bigint, smallint,
-- tinyint, decimal, numeric, float, real, varchar, nvarchar, char, nchar,
-- text, ntext, date, time, datetime, datetime2, bit, uniqueidentifier, varbinary
-- Qui sovrascriviamo i casi che vogliamo forzare diversamente.
CAST
    -- BIT → boolean (pgloader 3.6.x ha già il cast nativo, no transform custom).
    -- ATTENZIONE: NON usare "using bit-to-boolean": quella funzione esiste
    -- solo in pgloader >= 3.7 e fa KABOOM su versioni precedenti.
    type bit to boolean drop typemod,

    -- datetime/datetime2/smalldatetime → timestamptz (timezone Europe/Rome)
    type datetime to "timestamp with time zone" drop default drop not null,
    type datetime2 to "timestamp with time zone" drop default drop not null,
    type smalldatetime to "timestamp with time zone" drop default drop not null,
    type datetimeoffset to "timestamp with time zone" drop default drop not null,

    -- uniqueidentifier → TEXT (NON uuid).
    -- Motivo: pgloader 3.6.x trasforma uniqueidentifier in byte-array raw
    -- "#(195 119 ...)" che Postgres rifiuta come UUID ("invalid input
    -- syntax"). Le tabelle che usano uniqueidentifier sono prevalentemente
    -- aspnet_* (skip nel nostro target) e alcune *_bk (backup interni).
    -- Le tabelle reali del business (bandi/gare/aziende) usano INT non UUID,
    -- quindi non ne sono interessate. Se in futuro servono UUID puri, si
    -- castano TEXT → UUID in post-migration.
    type uniqueidentifier to text drop typemod,

    -- nvarchar senza limite → text (meno problemi con TOAST)
    type nvarchar when (= precision 0) to text drop typemod,
    type varchar when (= precision 0) to text drop typemod,
    type nvarchar when (> precision 4000) to text drop typemod,
    type varchar when (> precision 8000) to text drop typemod,

    -- ntext/text → text
    type ntext to text,
    type "ntext" to text,

    -- money/smallmoney → numeric(19,4)
    type money to "numeric(19,4)" drop typemod,
    type smallmoney to "numeric(10,4)" drop typemod,

    -- image/varbinary → bytea
    type image to bytea drop typemod,
    type varbinary to bytea drop typemod,

    -- xml → xml (Postgres ha supporto nativo)
    type xml to xml drop typemod,

    -- sql_variant: non supportato bene, dump a text
    type sql_variant to text drop typemod

-- ============================================================================
-- SCHEMA RENAMING — IMPORTANTE
-- ============================================================================
-- Lo schema legacy SQL Server "dbo" finisce in Postgres come "legacy" (NON
-- "public") per due motivi:
--
--   1. Lo schema "public" del nuovo sito è già stato creato a mano via
--      backend/src/db/migrations/001-036 (struttura modernizzata: bandi.id
--      UUID, snake_case, FK migliorate, ecc.). pgloader importerebbe in
--      public e sovrascriverebbe TUTTO con lo schema legacy CamelCase-INT.
--
--   2. La trasformazione legacy → public richiede un mapping INT→UUID
--      per la PK di bandi (legacy: IdBando INT; nuovo: id UUID). Lo fa
--      lo script staging/transform-legacy-to-public.sql dopo pgloader.
--
-- Pipeline migrazione (2 step):
--     pgloader  →  legacy.* (CamelCase-flatten, tipi tradotti)
--     transform-legacy-to-public.sql  →  public.* (snake_case, UUID, FK)
ALTER SCHEMA 'dbo' RENAME TO 'legacy'

-- ============================================================================
-- TABELLE DA ESCLUDERE
-- ============================================================================
-- Escludo:
--  ~/_bk$/        — tabelle backup interne (aziendebk, attestazioniaziendebk, ...)
--                   sono backup intermedi del DBA, non utili per staging
--                   AND possono essere grandi (heap pressure)
--  ~/^sysdiagrams$/ — diagram metadata di SSMS, non dati reali
EXCLUDING TABLE NAMES MATCHING ~/_bk$/, ~/^sysdiagrams$/

-- ============================================================================
-- TABELLE DA INCLUDERE (se vuoi partire "solo con il core")
-- ============================================================================
-- Commenta le opzioni EXCLUDING sopra e decommenta questa per fare una
-- migrazione parziale:
-- INCLUDING ONLY TABLE NAMES MATCHING
--     ~/^Bandi/, ~/^Gare/, ~/^Azienda/, ~/^Stazioni/, ~/^Province/,
--     ~/^Soa/, ~/^Users/, ~/^Dettaglio/, ~/^Concorrenti/, ~/^Apertura/,
--     ~/^AllegatiBando/, ~/^Punteggi/, ~/^GareRicorsi/

-- ============================================================================
-- BEFORE/AFTER LOAD (SQL custom)
-- ============================================================================
BEFORE LOAD DO
$$ CREATE EXTENSION IF NOT EXISTS "uuid-ossp"; $$,
$$ CREATE EXTENSION IF NOT EXISTS citext; $$,
$$ CREATE EXTENSION IF NOT EXISTS pg_trgm; $$

AFTER LOAD DO
$$ ANALYZE; $$;
