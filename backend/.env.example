# ============================================================
# DATABASE
# ============================================================
DATABASE_URL=postgresql://easywin:password@localhost:5432/easywin
DB_HOST=localhost
DB_PORT=5432
DB_NAME=easywin
DB_USER=easywin
DB_PASSWORD=your_password_here

# ============================================================
# SERVER
# ============================================================
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# ============================================================
# JWT
# ============================================================
JWT_SECRET=your_jwt_secret_here_change_in_production

# ============================================================
# CLAUDE AI (Anthropic)  --  necessario per:
#   - /api/bandi-ai/*    (analyze, create-from-pdf, enrich-from-allegati, ...)
#   - /api/esiti-ai/*    (analyze, create-from-pdf, analyze-graduatoria,
#                         commit-graduatoria, match-company, link-bando, ...)
# Tutte le route AI ritornano 500 con messaggio chiaro se la chiave manca.
# ============================================================
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Modelli AI: Haiku per import massivo (economico), Sonnet per analisi
# interattiva (qualità). I valori sono quelli verificati al 2026-05.
AI_MODEL_BULK=claude-haiku-4-5-20251001
AI_MODEL_INTERACTIVE=claude-sonnet-4-20250514

# ============================================================
# PRESIDIA WEB SERVICE  (import bandi)
# ============================================================
# Endpoint SOAP del web service Presidia. Il client SOAP fa la connessione
# tramite questa URL (vedi backend/src/services/presidia-soap.js).
# Default in codice: http://easywin.presidia.it/macsyws.asmx
PRESIDIA_SOAP_URL=http://easywin.presidia.it/macsyws.asmx

# Scheduler automatico Presidia (cron interno via setInterval).
# Quando 'true', il backend ad ogni avvio fa partire un loop che esegue
# l'import Presidia agli slot orari:
#   - 11:00, 12:00, 13:00, 14:00, 15:00, 16:00
#   - 16:45, 17:15, 17:45, 18:15, 18:45, 19:15
#   - 04:00 (riepilogo notturno, finestra ieri-oggi)
# Idempotente: ogni slot ha una slot_key registrata in presidia_import_runs.
# Imposta 'false' (o ometti) in ambienti di dev/staging dove non vuoi
# import involontari.
PRESIDIA_AUTO=false

# Nota: l'autenticazione verso Presidia è basata su GUID per chiamata,
# passato dall'admin via UI - NON ci sono PRESIDIA_USERNAME/PASSWORD
# globali. Le precedenti voci PRESIDIA_BASE_URL / PRESIDIA_USERNAME /
# PRESIDIA_PASSWORD erano placeholder mai usati dal codice e sono state
# rimosse da questo template.

# ============================================================
# FILE STORAGE
# ============================================================
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50

# ============================================================
# MAIL PROVIDER
# ============================================================
# Toggle: 'smtp' (default) | 'ses'
MAIL_PROVIDER=smtp

# --- SMTP (Nodemailer) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="EasyWin" <noreply@easywin.it>

# --- Amazon SES v2 (used when MAIL_PROVIDER=ses) ---
SES_REGION=eu-south-1
SES_ACCESS_KEY_ID=AKIA...                  # IAM user easywin-ses-sender
SES_SECRET_ACCESS_KEY=...
SES_FROM_ADDRESS=noreply@aura-proptech.com
SES_CONFIGURATION_SET=easywin-ses-tls      # opzionale
